<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.NavigatorsKakamega" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Main theme colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/text_primary</item>

        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Material Components Colors & Fix for Purple Text -->
        <item name="colorOnSurface">@color/black</item>
        <item name="colorOnSurfaceVariant">@color/black</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:editTextColor">@color/black</item>
        <item name="colorOutline">@color/border</item>
        <item name="colorSecondaryContainer">@color/background</item>
        <item name="colorOnSecondaryContainer">@color/black</item>

        <!-- Typography -->
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Navs.TitleLarge</item>

        <!-- Popup Menu Styling -->
        <item name="actionOverflowMenuStyle">@style/Widget.Navs.OverflowMenu</item>
        <item name="android:itemBackground">@color/accent</item>
        <item name="android:textColorSecondary">@color/black</item>
    </style>

    <style name="Widget.Navs.OverflowMenu" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@color/accent</item>
    </style>

    <style name="TextAppearance.Navs.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Theme.NavigatorsKakamega" parent="Base.Theme.NavigatorsKakamega" />

    <style name="ShapeAppearance.Navs.Circle" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">50%</item>
    </style>
</resources>